ENGINE	qdrant_engine_template
ENGINE_ALIAS	qdrant_engine_template
ENGINE_TYPE	prerna.engine.impl.vector.QdrantVectorDatabaseEngine
VECTOR_TYPE	QDRANT

EMBEDDER_ENGINE_ID	REPLACE_WITH_EMBEDDER_MODEL_ENGINE_ID
KEYWORD_ENGINE_ID
DISTANCE_METHOD	Cosine Similarity
INDEX_CLASSES	default
CONTENT_LENGTH	512
CONTENT_OVERLAP	0
DEFAULT_CHUNK_UNIT	tokens
DEFAULT_CHUNKING_METHOD	recursive
EXTRACTION_METHOD	None

QDRANT_LOCATION	AUTO
QDRANT_QUANTIZATION	none
QDRANT_ON_DISK_PAYLOAD	false
QDRANT_HNSW_M
QDRANT_HNSW_EF_CONSTRUCT
QDRANT_ENABLE_HYBRID_SEARCH	false
QDRANT_SPARSE_MODEL	Qdrant/bm25

IDLE_TIMEOUT	30
