#Base Properties
ENGINE	Collaboration
ENGINE_TYPE	prerna.engine.impl.rdbms.RDBMSNativeEngine
OWL	Collaboration_OWL.OWL

RDBMS_TYPE	POSTGRES
DBDRIVER	POSTGRES
DATABASE	postgres
SCHEMA	collaboration
DRIVER	org.postgresql.Driver
USERNAME	postgres
PASSWORD	postgres
CONNECTION_URL	jdbc:postgresql://localhost:5432/postgres?currentSchema=collaboration
USE_CONNECTION_POOLING	true
POOL_MIN_SIZE	10
POOL_MAX_SIZE	50
AUTO_COMMIT	false

DATABASE_ZONEID UTC
