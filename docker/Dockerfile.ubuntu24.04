# Base image arguments
ARG BASE_REGISTRY=docker.io
ARG BASE_IMAGE=ubuntu
ARG BASE_TAG=24.04

ARG COPILOT_VERSION=latest

#global argument for tomcat
ARG TOMCAT_VERSION=9.0.119
ARG TOMCAT_BUILDER_TAG=9.0.119-java25
ARG JAVA_HOME=/usr/lib/jvm/zulu25
ARG MAVEN_HOME=/opt/apache-maven-3.9.14

#setting up the tomcat builder for later below. this is for env var expansion.
FROM quay.io/semoss/tomcat-builder:${TOMCAT_BUILDER_TAG} AS tomcat_builder
ARG COPILOT_VERSION
# Provided automatically by buildx (amd64/arm64). Defaults to amd64 when building
# without buildx (TARGETARCH unset). copilot uses x64/arm64.
ARG TARGETARCH
RUN apt-get update -y \
	&& apt-get install -y --no-install-recommends ca-certificates curl tar \
	&& rm -rf /var/lib/apt/lists/* \
	&& tmp="$(mktemp -d)" \
	&& case "${COPILOT_VERSION}" in \
		latest) copilot_url="https://github.com/github/copilot-cli/releases/latest/download/copilot-linux-${copilot_arch}.tar.gz" ;; \
		*) copilot_url="https://github.com/github/copilot-cli/releases/download/${COPILOT_VERSION}/copilot-linux-${copilot_arch}.tar.gz" ;; \
	   esac \
	&& curl -fsSL -o "$tmp/copilot.tgz" "$copilot_url" \
	&& tar -xzf "$tmp/copilot.tgz" -C "$tmp" \
	&& install -m 0755 "$tmp/copilot" /usr/local/bin/copilot \
	&& rm -rf "$tmp" \
	&& chown 1001:0 /usr/local/bin/copilot

# FROM ${BASE_REGISTRY}/${BASE_IMAGE}:${BASE_TAG} AS base
FROM ${BASE_REGISTRY}/${BASE_IMAGE}:${BASE_TAG} AS mavenpuller

# Define environment variables in this stage
ARG TOMCAT_VERSION
ARG JAVA_HOME
ARG MAVEN_HOME
ARG SEMOSS_VERSION
ENV JAVA_HOME=${JAVA_HOME}
ENV TOMCAT_HOME=/opt/apache-tomcat-${TOMCAT_VERSION}
ENV MAVEN_HOME=${MAVEN_HOME}
ENV PATH=$PATH:$MAVEN_HOME/bin:$TOMCAT_HOME/bin:$JAVA_HOME/bin
ENV SEMOSS_VERSION=${SEMOSS_VERSION}
ENV MAVEN_ARGS="-B -ntp"
ENV DEBIAN_FRONTEND=noninteractive

# Get tomcat, maven and java from another image called tomcat-builder
COPY --from=tomcat_builder /opt /opt
COPY --from=tomcat_builder /usr/lib/jvm/zulu25 /usr/lib/jvm/zulu25

RUN apt-get update -qq \
	&& apt-get install -y -qq git curl unzip lsof \
	&& mkdir /opt/semosshome \
	&& cd /opt && git clone https://github.com/SEMOSS/semoss-artifacts \
	&& chmod 777 /opt/semoss-artifacts/artifacts/scripts/*.sh \
	&& /opt/semoss-artifacts/artifacts/scripts/update_latest_dev.sh \
	&& rm -rf /root/.m2 \
	&& chmod 777 /opt/semosshome/config/Chromedriver/* \
    && sed -i "s/tomcat.util.scan.StandardJarScanFilter.jarsToSkip=/tomcat.util.scan.StandardJarScanFilter.jarsToSkip=*.jar,/g" $TOMCAT_HOME/conf/catalina.properties;


RUN useradd -u 1001 -r -g 0 -d ${HOME} -s /bin/bash         \
-c "Default Application User" default &&                \
chown -R 1001:0 ${HOME}

RUN mkdir /opt/chroot

RUN chown -R 1001:0 /opt

FROM ${BASE_REGISTRY}/${BASE_IMAGE}:${BASE_TAG} AS final

LABEL maintainer="semoss@semoss.org"

# From JAVA/tomcat
ARG TOMCAT_VERSION
ARG JAVA_HOME
ARG MAVEN_HOME
ENV JAVA_HOME=${JAVA_HOME}
ENV TOMCAT_VERSION=${TOMCAT_VERSION}
ENV TOMCAT_HOME=/opt/apache-tomcat-${TOMCAT_VERSION}
ENV VIRTUAL_ENV="/usr/lib/python/semossvenv"
ENV PATH=$VIRTUAL_ENV/bin:$PATH:$MAVEN_HOME/bin:$TOMCAT_HOME/bin:$JAVA_HOME/bin:/opt/semoss-artifacts/artifacts/scripts
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

COPY --from=tomcat_builder /usr/lib/jvm/zulu25 /usr/lib/jvm/zulu25
COPY --from=tomcat_builder /usr/local/bin/copilot /usr/local/bin/copilot

ENV DEBIAN_FRONTEND=noninteractive
RUN	apt-get update -qq \
	&& apt-get install -y -qq git curl unzip lsof vim nano

RUN curl -fsSL https://rclone.org/install.sh | bash \
	&& chmod 755 /usr/bin/rclone

## TODO - couldnt get the following to work
# RUN wget -q -O - https://dl.google.com/linux/linux_signing_key.pub | apt-key add - \
# 	&& echo "deb http://dl.google.com/linux/chrome/deb/ stable main" | tee /etc/apt/sources.list.d/google-chrome.list \
# 	&& apt-get update \
# 	&& apt-get install -y google-chrome-stable bash


COPY --from=mavenpuller --chown=1001:0 /opt /opt
COPY --from=quay.io/semoss/python-builder:3.12-cpu  /usr/lib/python /usr/lib/python


#LOCALE
RUN apt-get update -qq \
	&& apt-get install -y -qq locales \
	&& locale-gen en_US.UTF-8 \
	&& dpkg-reconfigure --frontend=noninteractive locales \
	&& locale -a

# Pulling files from the SEMOSS/semoss-artifacts folder
RUN	cd /opt/semoss-artifacts \
	&& chmod 777 artifacts/dockerBuilder_scripts/* \
	&& cp ./artifacts/dockerBuilder_scripts/install_Playwright_linux_dependencies.sh /tmp/install_Playwright_linux_dependencies.sh \
	&& cp ./artifacts/dockerBuilder_scripts/playwright-pom.xml /tmp/pom.xml

# Install playwright dependencies
RUN	cd /tmp \
	&& ./install_Playwright_linux_dependencies.sh \
	&& rm -rf /root/.m2

RUN apt install -y debootstrap fakechroot fakeroot uidmap util-linux

# Bake the shared chroot template at build time (as root) so the running
# container never builds it. Writes /opt/chroot/.template/.ready, which makes
# ChrootTemplate.awaitReady() a no-op at startup. Auto-detects Ubuntu/RHEL paths.
RUN bash /opt/semoss-artifacts/artifacts/scripts/build_chroot_template.sh /opt/chroot

RUN useradd -u 1001 -r -g 0 -d ${HOME} -s /bin/bash         \
	-c "Default Application User" default &&                \
	chown -R 1001:0 ${HOME}

USER 1001

WORKDIR /opt/semoss-artifacts/artifacts/scripts
CMD ["bash", "-c", "exec $TOMCAT_HOME/bin/start.sh" ]
