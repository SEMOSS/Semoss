# SEMOSS sandbox image: the OpenShell sandbox that runs a user's persistent python worker.
#
# Published by .github/workflows/sandbox-builder.yml as quay.io/semoss/semoss-sandbox, the default
# OPENSHELL_IMAGE. To try a py/ change before it is published:
#
#   docker build -f docker/Dockerfile.sandbox -t semoss-sandbox:dev py    # context is py/
#   docker/sandbox-smoke-test.sh semoss-sandbox:dev
#
# Python and every dependency come from the python-builder image (docker/Dockerfile.python,
# uv + py/install_config/pyproject.toml). Like the Tomcat images, we copy its /usr/lib/python
# onto a plain Ubuntu base, so a Py() block has the same interpreter and imports inside the
# sandbox as outside it.
#
# The venv is reached by explicit path, never by PATH lookup: OpenShell builds the environment
# for the processes it spawns, so ENV PATH is not applied inside a sandbox. See
# docs/deployment/executor_sandbox.md.
ARG BASE_REGISTRY=public.ecr.aws/docker/library
ARG BASE_IMAGE=ubuntu
ARG BASE_TAG=24.04

FROM ${BASE_REGISTRY}/${BASE_IMAGE}:${BASE_TAG}

LABEL maintainer="semoss@semoss.org"
LABEL org.semoss.component="sandbox"

ENV DEBIAN_FRONTEND=noninteractive

# git for local repository work; egress stays policy-gated per binary
RUN for i in 1 2 3; do apt-get update && break || (sleep 10 && rm -rf /var/lib/apt/lists/*); done \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# uv-managed CPython + semossvenv; /usr/lib/python sits inside the policy's read-only /usr
COPY --from=quay.io/semoss/python-builder:3.14-cpu  /usr/lib/python /usr/lib/python

# One interpreter path for every build: the sandbox policy's egress rules name the kernel-reported
# executable, and uv's directory carries the patch version and the CPU architecture
# (cpython-3.14.8-linux-aarch64-gnu). Move the tree to a fixed name and leave the original as a
# symlink, so the venv still resolves and the policy can say /usr/lib/python/cpython/bin/python3.14.
RUN real="$(readlink -f /usr/lib/python/semossvenv/bin/python3)" \
 && dir="$(dirname "$(dirname "$real")")" \
 && mv "$dir" /usr/lib/python/cpython \
 && ln -s cpython "$dir" \
 && test "$(readlink -f /usr/lib/python/semossvenv/bin/python3)" = "/usr/lib/python/cpython/bin/$(basename "$real")"
# Packages example apps need that SEMOSS does not declare (Stock MCP: yfinance). A stopgap until an
# app can declare its own dependencies; keep the list short, and pass APP_PACKAGES="" to omit it.
ARG APP_PACKAGES="yfinance"
RUN if [ -n "${APP_PACKAGES}" ]; then \
      /usr/lib/python/semossvenv/bin/python3 -m pip install --no-cache-dir ${APP_PACKAGES}; \
    fi
ENV VIRTUAL_ENV=/usr/lib/python/semossvenv
ENV PATH=/usr/lib/python/semossvenv/bin:$PATH

# the sandbox identity is uid/gid 1000 (ubuntu:24.04 already has it as "ubuntu")
RUN if ! getent group 1000 >/dev/null; then groupadd -g 1000 sandbox; fi \
 && if ! getent passwd 1000 >/dev/null; then useradd -u 1000 -g 1000 -m -s /bin/bash sandbox; fi

# the worker source (build context is the repo's py/)
COPY . /opt/semosshome/py/

# setup() appends to insight/log.txt; grants-* are the policy's ro/rw drop points
RUN mkdir -p /opt/semosshome/insight /opt/grants-rw /opt/grants-ro \
 && touch /opt/semosshome/insight/log.txt \
 && chown -R 1000:1000 /opt/semosshome /opt/grants-rw /opt/grants-ro \
 && chmod 755 /opt/grants-rw /opt/grants-ro

# Workstation homes. Files cross into a sandbox at their host path, so a Mac's BaseFolder
# (/Users/me/...) or a Linux one (/home/me/...) must exist inside it. A sandbox can only create
# directories under a path its policy grants and that exists at start, so these roots are made
# here, owned by the sandbox user; OpenShellTransport grants the root and creates the home.
RUN mkdir -p /Users && chown 1000:1000 /Users /home

# OpenShell refuses to start unless the workspace is writable by the sandbox identity
USER 1000:1000
WORKDIR /opt/semosshome/py
