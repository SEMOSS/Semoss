<?xml version="1.0" encoding="UTF-8"?>
<Server port="-1">
  <Listener className="org.apache.catalina.core.JreMemoryLeakPreventionListener"/>
  <Service name="Catalina">
    <Connector port="8443" protocol="org.apache.coyote.http11.Http11NioProtocol"
               SSLEnabled="true" scheme="https" secure="true"
               sslImplementationName="org.apache.tomcat.util.net.jsse.JSSEImplementation"
               maxThreads="200" connectionTimeout="20000" allowTrace="false"
               maxParameterCount="1000" maxPostSize="10485760">
      <!-- certificateVerification (on the SSLHostConfig below) is "want" (request,
           do not insist on, a client certificate) unless CAC_PIV_REQUIRED=false and
           CAC_PIV_CLIENT_AUTH is not true (see setenv.sh). It lives on the
           SSLHostConfig, not on this Connector: Tomcat 11 rejects a Connector-level
           clientAuth ("failed to set property [clientAuth]" at startup) and a server
           configured that way never sends a certificate request, so no card is ever
           asked for. It is deliberately not "true": a connector that insists
           ends the TLS handshake, and the browser then shows its own error page
           with no way to explain what to do. Monolith's CACRequiredFilter makes
           the requirement instead and sends a browser without a certificate to a
           "CAC required" page. A certificate the browser DOES present is
           validated here against the trust store named below - the DoD PKI CA
           bundle a site mounts at /run/secrets/cac-truststore.bcfks (the
           entrypoint refuses to start without it). Without an explicit trust
           store the JVM's public-CA store would apply and any publicly issued
           client certificate would pass. CACFilter.java and PIVFilter.java
           (Monolith) read the validated certificate from the request; see
           docker/il4/README.md's CAC/PIV section. -->
      <SSLHostConfig protocols="TLSv1.2,+TLSv1.3" sslProtocol="TLS"
                     certificateVerification="${cac.piv.client.auth:-false}"
                     keyManagerAlgorithm="PKIX"
                     groups="secp256r1,secp384r1,secp521r1,ffdhe2048,ffdhe3072"
                     cipherSuites="TLS_AES_256_GCM_SHA384,TLS_AES_128_GCM_SHA256"
                     ciphers="TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256"
                     truststoreFile="${cac.piv.truststore.file:-/opt/fips/cacerts.bcfks}"
                     truststoreType="BCFKS" truststoreProvider="BCFIPS"
                     truststorePassword="${cac.piv.truststore.password:-changeit}"
                     sessionTimeout="30">
        <Certificate certificateKeystoreFile="/run/secrets/server.bcfks"
                     certificateKeystoreType="BCFKS" certificateKeystoreProvider="BCFIPS"
                     certificateKeystorePasswordFile="/run/secrets/server.password"/>
      </SSLHostConfig>
    </Connector>
    <Engine name="Catalina" defaultHost="localhost">
      <!-- xmlBase is where Tomcat looks for a per-application context descriptor. By
           default that is conf/Catalina/localhost, which holds none. With
           SESSION_STORE=jdbc the entrypoint writes a Monolith descriptor to a private
           temporary directory and setenv.sh points session.xml.base at it, so only
           Monolith (not the static SemossWeb) keeps its sessions in the shared store.
           See session_store.py and README "Sessions across several containers". -->
      <Host name="localhost" appBase="webapps" unpackWARs="false" autoDeploy="false" deployXML="false"
            xmlBase="${session.xml.base:-conf/Catalina/localhost}">
        <Valve className="org.apache.catalina.valves.ErrorReportValve"
               showReport="false" showServerInfo="false"/>
        <Valve className="org.apache.catalina.valves.AccessLogValve"
               directory="/dev" prefix="stdout" suffix="" rotatable="false"
               pattern="%a %t %m %U %s %b %D"/>
      </Host>
    </Engine>
  </Service>
</Server>
