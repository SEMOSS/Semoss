# SEMOSS executor sandbox — full-parity build.
#
#   MODE=full TAG=semoss-executor:full docker/build-executor-image.sh
#   # or directly:
#   docker build -f docker/Dockerfile.executor-full -t semoss-executor:full py
#
# Why this exists next to Dockerfile.executor: the minimal image carries three packages, so a
# Py() block that ran against the platform's own runtime (numpy, boto3, langchain, torch, ...)
# fails with ImportError the moment it is sandboxed. That is a silent capability regression, not
# a size trade-off.
#
# Base is Ubuntu, matching docker/Dockerfile.python, so sandbox and platform share a distro,
# glibc and the native libraries that document/OCR stacks expect. Python comes from apt (24.04
# ships 3.12) and the declared dependencies install into a venv with uv — the same installer
# upstream uses for its own runtime.
#
# The venv is reached by EXPLICIT PATH, never by PATH lookup: OpenShell builds the environment
# for the processes it spawns, so an image's ENV PATH is not applied inside a sandbox. The
# worker is launched as /usr/lib/python/semossvenv/bin/python3 (see OpenShellTransport) and the
# sandbox is created with `--env PATH=/usr/lib/python/semossvenv/bin:…` so user code resolves
# to the same interpreter.
ARG UBUNTU_VERSION=24.04

FROM ubuntu:${UBUNTU_VERSION} AS deps

ARG EXTRAS=cpu
ENV EXTRAS=${EXTRAS}
ENV DEBIAN_FRONTEND=noninteractive

# Build toolchain lives in this stage only: several declared dependencies ship no aarch64
# wheel (annoy is a C++ extension and was the first to fail), so they compile from source.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 python3.12 python3.12-dev python3.12-venv python3-venv build-essential cmake pkg-config curl ca-certificates \
      libssl-dev zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev libffi-dev \
 && rm -rf /var/lib/apt/lists/*

# uv, the installer SEMOSS uses for its own runtime.
COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /uvx /usr/local/bin/

WORKDIR /build

COPY pyproject.toml ./
COPY export_requirements.py ./

RUN python3 export_requirements.py pyproject.toml "${EXTRAS}" > /tmp/requirements.txt \
 && echo "installing $(wc -l < /tmp/requirements.txt) declared dependencies (extra: ${EXTRAS:-none})" \
 && uv venv /usr/lib/python/semossvenv --python /usr/bin/python3.12 --seed \
 && case "${EXTRAS}" in \
      cpu) torch_index=https://download.pytorch.org/whl/cpu ;; \
      gpu) torch_index=https://download.pytorch.org/whl/cu126 ;; \
      *)   torch_index= ;; \
    esac \
 && if [ -n "$torch_index" ]; then \
      echo "torch trio from $torch_index (upstream pins this in [tool.uv.sources])"; \
      uv pip install --python /usr/lib/python/semossvenv/bin/python --index-url "$torch_index" \
        torch torchvision torchaudio; \
    fi \
 && uv pip install --python /usr/lib/python/semossvenv/bin/python -r /tmp/requirements.txt \
 && uv pip install --python /usr/lib/python/semossvenv/bin/python "levenshtein>=0.27.3"

FROM ubuntu:${UBUNTU_VERSION}

LABEL maintainer="semoss@semoss.org"
LABEL org.semoss.component="executor-sandbox-full"

ENV DEBIAN_FRONTEND=noninteractive

# python3.12 must exist in this stage too: the venv's interpreter is a symlink to
# /usr/bin/python3.12. git enables local repository work; egress stays policy-gated.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3.12 git ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && git config --system user.name "SEMOSS Sandbox" \
 && git config --system user.email "sandbox@semoss.local" \
 && git config --system safe.directory '*'

# The venv lives under /usr/lib/python, matching docker/Dockerfile.python. That path is
# inside the sandbox policy's read-only /usr, which /opt/venv would not be.
COPY --from=deps /usr/lib/python/semossvenv /usr/lib/python/semossvenv
ENV VIRTUAL_ENV=/usr/lib/python/semossvenv
ENV PATH=/usr/lib/python/semossvenv/bin:$PATH

# The worker source. The build script stages the repo's py/ as the context's py/.
COPY py/ /opt/semosshome/py/

RUN mkdir -p /opt/semosshome/insight /opt/grants-rw /opt/grants-ro \
 && touch /opt/semosshome/insight/log.txt \
 && chown -R 1000:1000 /opt/semosshome /opt/grants-rw /opt/grants-ro \
 && chmod 755 /opt/grants-rw /opt/grants-ro

# OpenShell refuses to start unless the workspace is writable by the sandbox identity.
USER 1000:1000
WORKDIR /opt/semosshome/py
