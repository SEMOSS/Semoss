# Environment variables for OpenAI, Azure OpenAI and Bedrock testing

# Client - OpenAI
OPENAI_API_KEY=<your-openai-api-key>

# Client - OpenAI - Azure
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_GPT_4O_ENDPOINT=<your-azure-openai-gpt-4o-endpoint>
AZURE_OPENAI_O1_MINI_ENDPOINT=<your-azure-openai-o1-mini-endpoint>

# Client - Bedrock
AWS_SECRET_KEY=<your-secret-key>
AWS_ACCESS_KEY=<your-access-key>