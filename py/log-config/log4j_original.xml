<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd">
<log4j:configuration debug="true"
	xmlns:log4j='http://jakarta.apache.org/log4j/'>

	<appender name="file" class="org.apache.log4j.RollingFileAppender">
	   <param name="append" value="false" />
	   <param name="maxFileSize" value="10KB" />
	   <param name="maxBackupIndex" value="5" />
	   <!-- Py Thread -->
	   <param name="file" value="FILE_LOCATION" />
	   <layout class="org.apache.log4j.PatternLayout">
		<param name="ConversionPattern" 
			value="%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1}:%L - %m%n" />
	   </layout>
	</appender>
	<appender name="KafkaAppender" class="org.apache.log4j.KafkaAppender">
	   <param name="brokerlist" value="localhost:9092" />
	   <param name="topic" value="logs" />
	  
	   <param name="ConsoleAppender" target="SYSTEM_OUT" />
	   <layout class="org.apache.log4j.PatternLayout">
		<!-- <param name="ConversionPattern" value="%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1}:%L - %m%n" /> -->
		<param name="ConversionPattern" value="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5p %c - %m%n" />
	   </layout>
	</appender>
	
	

	<root>
		<level value="DEBUG" />
		<appender-ref ref="file" />
		
		<level value="INFO" />
		<appender-ref ref="KafkaAppender" />
		<appender-ref ref="ConsoleAppender" />
	</root>

</log4j:configuration>