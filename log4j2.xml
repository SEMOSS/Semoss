<?xml version="1.0" encoding="UTF-8"?>
<Configuration xmlns:xi="http://www.w3.org/2001/XInclude" xmlns="https://logging.apache.org/xml/ns" 
	status="INFO" 
	packages="prerna.logging">
	<Appenders>
		<!-- Console Appender -->
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout>
				<Pattern>[%-5level] %d{yyyy-MM-dd HH:mm:ss} %c{1.}:%L [user=%X{userId}] [session=%X{sessionId}] [ip=%X{clientIP}] %m%n
				</Pattern>
			</PatternLayout>
		</Console>

		<!-- Rolling File Appender -->
		<RollingFile name="RollingFile"
			fileName="${sys:catalina.base}/logs/semossLog.log"
			filePattern="${sys:catalina.base}/logs/${date:yyyy-MM-dd}/semossLog-%d{yyyy-MM-dd}-%i.log">
			<PatternLayout>
				<Pattern>[%-5level] %d{yyyy-MM-dd HH:mm:ss} %c{1.}:%L [user=%X{userId}] [session=%X{sessionId}] [ip=%X{clientIP}] %m%n
				</Pattern>
			</PatternLayout>
			<Policies>
				<TimeBasedTriggeringPolicy interval="1"
					modulate="true" />
				<SizeBasedTriggeringPolicy size="250MB" />
			</Policies>
			<DefaultRolloverStrategy max="1000" />
		</RollingFile>

		<!-- Async wrappers -->
		<Async name="AsyncConsole" includeLocation="true">
			<AppenderRef ref="Console" />
		</Async>

		<Async name="AsyncRollingFile" includeLocation="true">
			<AppenderRef ref="RollingFile" />
		</Async>
		
		<!-- Database Appender -->
        <ServerLogsJDBCAppender name="ServerLogsJDBCAppender" />
        <AuditLogsJDBCAppender name="AuditLogsJDBCAppender" />
        
        <!-- Queue Appenders -->
        <!-- <QueueAppender name="QueueAppender"
		    destinationType="kafka" topicOrQueue="logs1"
			bootstrapServers="localhost:9092"> 
			<PatternLayout>
				<Pattern>{"timestamp":"%d{yyyy-MM-dd HH:mm:ss}","level":"%p","thread":"%t","logger":"%c","message":"%m","mdc":%X}%n
				</Pattern>
			</PatternLayout>
			<KafkaRabbitMQAvaliabilityFilter onMatch="ACCEPT" onMismatch="DENY" />
		</QueueAppender> -->
		
	</Appenders>
	<Loggers>
		<Logger name="EngineLogger" level="INFO">
			<AppenderRef ref="AuditLogsJDBCAppender" />
		</Logger>
		<Logger name="prerna" level="INFO"/>
		<Root level="WARN" includeLocation="true">
			<AppenderRef ref="Console" />
			<AppenderRef ref="RollingFile" />
			<AppenderRef ref="AuditDatabase" />
		</Root>
	</Loggers>
</Configuration>