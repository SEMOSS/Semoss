{
  "namespace": "logging",
  "type": "record",
  "name": "AvroAuditLogEvent",
  "fields": [
    {
      "name": "timestamp",
      "type": "long"
    },
    {
      "name": "level",
      "type": "string"
    },
    {
      "name": "logger",
      "type": "string"
    },
    {
      "name": "message",
      "type": "string"
    },
    {
      "name": "thread",
      "type": "string"
    },
    {
      "name": "contextMap",
      "type": {
        "type": "map",
        "values": ["null","string"],
        "default":{}
      }
    }
  ]
}