# ------------------------------------------------------------
# Paths and folders
# ------------------------------------------------------------
BaseFolder	C:\\workspace\\Semoss
INSIGHT_CACHE_DIR C:\\workspace\\Semoss\\InsightCache
CSV_INSIGHT_CACHE_FOLDER CSV_Insights
SOCIAL	C:\\workspace\\Semoss\\social.properties
EMAIL_TEMPLATES	C:\\workspace\\Semoss\\emailTemplates\\
ADDITIONAL_REACTORS C:\\workspace\\Semoss\\reactors.json
ADDITIONAL_REACTOR_PACKAGES

# ------------------------------------------------------------
# Engine and project watchers
# ------------------------------------------------------------
ENGINE_WEB_WATCHER	SMSSWebWatcher;SMSSStorageWatcher;SMSSModelWatcher;SMSSVectorWatcher;SMSSFunctionWatcher;SMSSGuardrailWatcher
PROJECT_WATCHER	ProjectWatcher

SMSSWebWatcher	prerna.util.SMSSWebWatcher
SMSSWebWatcher_DIR	C:\\workspace\\Semoss\\db
SMSSWebWatcher_EXT	.smss
SMSSWebWatcher_ETYPE	DATABASE

SMSSStorageWatcher	prerna.util.SMSSNoInitEngineWatcher
SMSSStorageWatcher_DIR	C:\\workspace\\Semoss\\storage
SMSSStorageWatcher_EXT	.smss
SMSSStorageWatcher_ETYPE	STORAGE

SMSSModelWatcher	prerna.util.SMSSNoInitEngineWatcher
SMSSModelWatcher_DIR	C:\\workspace\\Semoss\\model
SMSSModelWatcher_EXT	.smss
SMSSModelWatcher_ETYPE	MODEL

SMSSVectorWatcher	prerna.util.SMSSNoInitEngineWatcher
SMSSVectorWatcher_DIR	C:\\workspace\\Semoss\\vector
SMSSVectorWatcher_EXT	.smss
SMSSVectorWatcher_ETYPE	VECTOR

SMSSFunctionWatcher	prerna.util.SMSSNoInitEngineWatcher
SMSSFunctionWatcher_DIR	C:\\workspace\\Semoss\\function
SMSSFunctionWatcher_EXT	.smss
SMSSFunctionWatcher_ETYPE	FUNCTION

SMSSGuardrailWatcher	prerna.util.SMSSNoInitEngineWatcher
SMSSGuardrailWatcher_DIR	C:\\workspace\\Semoss\\guardrail
SMSSGuardrailWatcher_EXT	.smss
SMSSGuardrailWatcher_ETYPE	GUARDRAIL

#SMSSVenvWatcher	prerna.util.SMSSNoInitEngineWatcher
#SMSSVenvWatcher_DIR	C:\\workspace\\Semoss\\venv
#SMSSVenvWatcher_EXT	.smss
#SMSSVenvWatcher_ETYPE	VENV

ProjectWatcher	prerna.util.ProjectWatcher
ProjectWatcher_DIR		C:\\workspace\\Semoss\\project
ProjectWatcher_EXT	.smss

#JobSchedulerWatcher prerna.rpa.JobSchedulerWatcher
#JobSchedulerWatcher_DIR C:\\workspace\\Semoss\\rpa\\json
#JobSchedulerWatcher_EXT	.json

# ------------------------------------------------------------
# Deployment and web
# ------------------------------------------------------------
FE_WEB_APP_NAME
#WHAT SAMESITE COOKIE VALUE DO YOU WANT
#POSSIBLE VALUES INCLUDE strict, lax, none
SAMESITE_COOKIE none
#Caching for tasks
X_CACHE false
#SET THE EMBED URL IMAGE
#FILENAME MUST BE FOUND IN semoss_home\images\embed
#IF NO IMAGE, USE NONE
EMBED_URL_LOGO	semoss_logo_dark.svg

GH_PUBLIC_ORIGIN_OVERRIDE
GH_WEBHOOK_URL_OVERRIDE

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
USE_PYTHON true
PYTHONHOME C:\\workspace\\Semoss\\py\\install_config\\.venv

#THIS IS FOR TESTING ONLY
#FORCE_PORT 9999

# ------------------------------------------------------------
# R
# ------------------------------------------------------------
USE_R false
#R MEMORY LIMIT
R_MEM_LIMIT 4096
R_CONNECTION_JRI	false
#JRI must be false in order to use user rserve
IS_USER_RSERVE false
#Options are pooled or dedicated
R_USER_CONNECTION_TYPE pooled
#Only relevant if set to pooled
RSERVE_CONNECTION_POOL_SIZE 12
R_USER_RECOVERY_DEFAULT false
#Kill existing Rserve processes on startup
R_KILL_ON_STARTUP true

#USE SOCKET FOR RUNNING R IN SEPARATE PROCESS
NETTY_R false

# ------------------------------------------------------------
# Node
# ------------------------------------------------------------
NODE_HOME C:\\Program Files\\nodejs
NODE_ENV_DIR C:\\workspace\\Semoss\\js\\node_env

# ------------------------------------------------------------
# Terminals
# ------------------------------------------------------------
DISABLE_TERMINAL
DISABLE_R_TERMINAL
DISABLE_PY_TERMINAL
DISABLE_GIT_TERMINAL

#DEFAULT TERMINAL MODE
#VALID ONLY FOR WINDOWS
#USE "cmd" or "powershell"
TERMINAL_MODE cmd

# ------------------------------------------------------------
# Frames and defaults
# ------------------------------------------------------------
#SET DEFAULT FRAME TO LOAD DATA
#Frame type options: GRID, R, NATIVE, GRAPH, PY
DEFAULT_FRAME_TYPE GRID
#CURRENTLY ONLY SUPPORT VALUES OF : H2_DB OR SQLITE
DEFAULT_GRID_TYPE H2_DB
#SET THE DEFAULT SCRIPTING LANGUAGE
#THIS WILL DETERMINE IF WE SWITCH TO R OR PY IN CLEAN/ANALYTICS
DEFAULT_SCRIPTING_LANGUAGE R
#SET DEFAULT INSIGHTS RDBMS 
#CURRENTLY ONLY SUPPORT VALUES OF : H2_DB OR SQLITE
#DEFAULT IS H2_DB IF THIS IS REMOVED
DEFAULT_INSIGHTS_RDBMS H2_DB

#SIZE LIMIT FOR ROW by COL 
#FOR NO LIMIT USE -1
FRAME_SIZE_LIMIT -1
#DO WE LIMIT FOR NATIVE FRAMES
FRAME_SIZE_LIMIT_NATIVE false
#SET RESTRICTIONS ON PIVOT SIZE
PIVOT_ROW_MAX	1000
PIVOT_COL_MAX	100

# ------------------------------------------------------------
# Insight cache
# ------------------------------------------------------------
#SET IF INSIGHTS ON SAVE ARE CACHEABLE
DEFAULT_INSIGHT_CACHEABLE	true

# ------------------------------------------------------------
# Memory and file limits
# ------------------------------------------------------------
FILE_TRANSFER_LIMIT 5000

# ------------------------------------------------------------
# Export
# ------------------------------------------------------------
#Use a custom chrome binary
#GOOGLE_CHROME_BINARY C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
#SEMOSS logo used for exporting files
EXPORT_SEMOSS_LOGO C:\\workspace\\Semoss\\images\\embed\\semoss_logo.png
PLAYWRIGHT_EXPORT true

# ------------------------------------------------------------
# Project app builds
# ------------------------------------------------------------
#URL of the SEMOSS node-builder service; BuildAndPublishApp sends a project's assets/client source there to build it
NODE_SERVER_ENDPOINT

# ------------------------------------------------------------
# Scheduler
# ------------------------------------------------------------
#SCHEDULER ENDPOINT - ONLY THE ROOT OF THE URL - example: http://localhost:8080/Monolith
SCHEDULER_ENDPOINT	http://localhost:8080/Monolith
SCHEDULER_KEYSTORE
SCHEDULER_KEYSTORE_PASSWORD
SCHEDULER_CERTIFICATE_PASSWORD

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
#ENCODE LOGS
LOG_ENCODING false

# ------------------------------------------------------------
# System databases and tracking
# ------------------------------------------------------------
MODEL_INFERENCE_LOGS_ENABLED true
PROMPT_DB_ENABLED true
AUDIT_LOGS_DATABASE_ENABLED true
NOTIFICATION_DATABASE_ENABLED true
COLLABORATION_DATABASE_ENABLED false
USER_TRACKING_ENABLED	false
USER_TRACKING_METHOD	GEOIP2

# ------------------------------------------------------------
# Collaboration (Brain/Work)
# ------------------------------------------------------------
COLLAB_CLASSIFIER_ENGINE_ID
COLLAB_LLM_ENGINE_ID

# ------------------------------------------------------------
# Agents
# ------------------------------------------------------------
AGENT_DEFAULT_TOOLS_ENABLE_NODE false

# A2A server adapter
A2A_ENABLED=false

# ------------------------------------------------------------
# Rooms and agent run coordination
# ------------------------------------------------------------
# Room transcript locking
ROOM_MESSAGE_STORE_LOCK_TTL_MS=300000
ROOM_MESSAGE_STORE_LOCK_WAIT_MS=5000

# RunAgent queue / active run / synchronous wait behavior
AGENT_RUN_ACTIVE_TTL_MS=300000
AGENT_RUN_WAIT_TIMEOUT_MS=3600000

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
# Shared Redis connection + enablement
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TIMEOUT_MS=2000
REDIS_PASSWORD=

# Redis Sentinel (high availability). When REDIS_SENTINEL_ENABLED=true the direct
# REDIS_HOST/REDIS_PORT is ignored and the master is discovered via the sentinels.
# REDIS_SENTINEL_NODES is a comma-separated host:port list (default sentinel port 26379).
# REDIS_PASSWORD authenticates the data nodes; REDIS_SENTINEL_PASSWORD (optional)
# authenticates the sentinels and is independent of REDIS_PASSWORD.
REDIS_SENTINEL_ENABLED=false
REDIS_MASTER_NAME=
REDIS_SENTINEL_NODES=
REDIS_SENTINEL_PASSWORD=

# Redis Cluster (horizontal sharding + HA). When REDIS_CLUSTER_ENABLED=true the
# direct REDIS_HOST/REDIS_PORT and any Sentinel config are ignored, and keys are
# routed across the cluster by hash slot. REDIS_CLUSTER_NODES is a comma-separated
# host:port seed list (default port 6379). REDIS_PASSWORD authenticates the nodes.
# Cluster takes precedence over Sentinel if both are enabled.
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_NODES=
REDIS_CLUSTER_MAX_ATTEMPTS=5

# ------------------------------------------------------------
# Secrets
# ------------------------------------------------------------
SECRET_STORE_ENABLED	false
#HASHICORP_VAULT or AZURE_KEYVAULT
SECRET_STORE_TYPE		
#Base Paths For Resources
SECRETS_DB_PATH			semoss-db
SECRETS_STORAGE_PATH	semoss-storage
SECRETS_MODEL_PATH		semoss-model
SECRETS_VECTOR_PATH		semoss-vector
SECRETS_FUNCTION_PATH 	semoss-function
SECRETS_GUARDRAIL_PATH semoss-guardrail
SECRETS_PROJECT_PATH	semoss-project
SECRETS_VENV_PATH		semoss-venv

#Hashicorp Vault
VAULT_ADDR				
VAULT_TOKEN				

#Azure KeyVault
#Note SECRET_*_PATH can only be contain alphanumeric and dashes
#ClientSecretCredential if passing in client/secret/tenant
AZURE_AUTHENTICATE_MODE	
AZURE_KEYVAULT_NAME	
AZURE_CLIENT_ID	
AZURE_CLIENT_SECRET	
AZURE_TENANT_ID 		

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
#SAML CONFIG
SAML_PROP_LOC	C:\\workspace\\Semoss\\saml\\mesoc\\conf	
SAML_FEDERATION_LOG_PATH	C:\\workspace\\Semoss\\saml\\mesoc\\conf\\debug\\Federation

#POST MESSAGE SPECIFIC KEYS
PM_SEMOSS_EXECUTE_SQL_ENCRYPTION_PASSWORD	password123

#Virus Scanning
VIRUS_SCANNING_ENABLED 	false
VIRUS_SCANNING_METHOD 	ClamAV
CLAMAV_SCANNING_PORT 	3310
CLAMAV_SCANNING_ADDRESS	 
CLAMAV_SCANNING_FS		

