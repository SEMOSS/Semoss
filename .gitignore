*.py[cod]
*$py.class

# mac OS
# General
.DS_Store
.AppleDouble
.LSOverride

# config files
RDF_Map.prop
social.properties

# ignore sablecc
/src/org/sablecc/**

# log4j plugin - created in maven build
/src/main/resources/META-INF/org/apache/logging/log4j/core/config/plugins/Log4j2Plugins.dat

# local engines
db/**
function/**
guardrail/**
model/**
project/**
room/**
storage/**
user/**
vector/**
*.mv.db
# Don't track anything but CSV_Insights folder
InsightCache/*
!InsightCache/CSV_Insights/
# Don't track anything but the .gitkeep folder in CSV_Insights. This is redundant but having .gitkeep is helpful reminder not to delete this folder
InsightCache/CSV_Insights/*
!InsightCache/CSV_Insights/.gitkeep

# test resources
test/resources/RDF_MAP.prop

# Mailpit binary lives next to the README (user-installed, see fixture readme)
test/resources/mailpit/mailpit
test/resources/mailpit/mailpit.exe
test/resources/mailpit/mailpit.log

# Python Virtual Environments 
venv/*

# Python local log file
py/log.txt

# Python .env
py/.env

# JetBrains IDE's
out/
.idea/
semoss.iml
